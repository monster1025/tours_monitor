# Telegram-бот (получите у @BotFather) и ID чата (у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Запускать скан сразу при старте (для первого наполнения базы), true/false
RUN_ON_START=true

# Горизонт дат в днях и размер топа в отчёте
DATE_RANGE_DAYS=90
TOP_N=5

# Порт веб-интерфейса (дашборд Hangfire на /hangfire)
PORT=8080
